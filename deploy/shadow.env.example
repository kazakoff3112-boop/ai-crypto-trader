# Copy to /opt/ai-crypto-trader/.env with mode 0600. No credentials are needed.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api-demo.bybit.com
TRADING_MODE=demo
DATABASE_PATH=/opt/ai-crypto-trader/data/ai_crypto_trader.sqlite3
HISTORICAL_CACHE_PATH=/opt/ai-crypto-trader/data/historical_market_data.sqlite3
SHADOW_DATABASE_PATH=/opt/ai-crypto-trader/data/shadow_trading.sqlite3
SHADOW_NOTIFICATIONS_PATH=/opt/ai-crypto-trader/data/shadow_notifications.sqlite3
AI_CRYPTO_TELEGRAM_BOT_TOKEN=
AI_CRYPTO_TELEGRAM_CHAT_ID=
